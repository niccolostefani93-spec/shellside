#!/usr/bin/env bash
# Shellwalk launcher: runs run.py with this checkout's own virtualenv.
#
#     ./shellwalk                start it
#     ./shellwalk setup          guided setup (LAN or not, port, autostart)
#     ./shellwalk status         what is configured, and whether it runs
#     ./shellwalk reset-auth     forgot the password: back to unconfigured
#     ./shellwalk --help         every start option
set -euo pipefail
here="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
python="$here/.venv/bin/python"
if [ ! -x "$python" ]; then
    echo "  No virtualenv yet. Run ./setup.sh first." >&2
    exit 1
fi
exec "$python" "$here/run.py" "$@"
